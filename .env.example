# 複製為 .env 後填入；.env 已列在 .gitignore，不會被提交

# LINE Developers Console → 你的 channel → Basic settings → Channel secret
# 用來驗證 Webhook 請求的 X-Line-Signature
LINE_CHANNEL_SECRET=your_channel_secret_here
# LINE Developers Console → 你的 channel → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 正式環境使用 PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database
# 本機試跑可改用 SQLite 檔案，不需要安裝 PostgreSQL
# DATABASE_URL=sqlite:///roster.db

# python app.py 監聽的連接埠（預設 5000；gunicorn 部署時由平台的 $PORT 決定）
# PORT=5000
