# 複製為 .env 後填入；.env 已列在 .gitignore，不會被提交
# 所有設定都走環境變數；部署平台（Render、Railway 等）請在其 Variables／Environment 頁面設定同名變數

# ── 必填：LINE Messaging API ─────────────────────────────
# LINE Developers Console → 你的 channel → Basic settings → Channel secret（驗證 X-Line-Signature）
LINE_CHANNEL_SECRET=your_channel_secret_here
# LINE Developers Console → 你的 channel → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# ── 資料庫 ───────────────────────────────────────────────
# 不設定時使用目前目錄的 SQLite 檔 bot.db（Docker 映像預設 /app/data/bot.db）
# DATABASE_URL=sqlite:///bot.db
# 使用 PostgreSQL 時：
# DATABASE_URL=postgresql://user:password@host:5432/database

# ── 管理員與通知 ─────────────────────────────────────────
# 可以使用 /待處理、/完成 的 LINE user ID，逗號分隔（Developers Console → Basic settings → Your user ID）
# ADMIN_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 轉真人通知：log（預設，寫進伺服器 log）或 line_push（推播給 ADMIN_USER_IDS，會計入官方帳號訊息則數）
# HANDOFF_NOTIFIER=log

# ── 內容設定檔（預設為 config/ 內的虛構範例店家）────────
# FAQ_FILE=config/faq.yaml
# RULES_FILE=config/rules.yaml

# ── 選配模組 ─────────────────────────────────────────────
# 群組成員名冊（/登記、/名冊 等指令）
# ROSTER_ENABLED=false
# AI 回答（只根據 FAQ 回答並附出處；顧客訊息會送到下列 API）
# AI_ENABLED=false
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=

# python -m support_bot.web 監聽的連接埠（預設 5000；gunicorn／Docker 部署時由平台的 $PORT 決定）
# PORT=5000
